# ⚠️ 复制为 .env，填好真值；.env 已在 .gitignore 里
# Vercel 部署时在 dashboard 的 Environment Variables 里填同名键

# 必填：智谱 API Key（https://bigmodel.cn/ 注册获取）
VISION_API_KEY=

# 可选：换其他兼容 OpenAI 的视觉模型
VISION_API_BASE=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4v

# 可选：调参
MAX_FILES=8
MAX_FILE_BYTES=10485760
DAILY_IP_LIMIT=30
FREE_TIER_LIMIT=3